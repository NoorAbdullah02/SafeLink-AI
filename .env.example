# SafeLink AI Environment Configuration Example
# Copy this file to .env and fill in your own keys. Do not commit .env to version control.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173

# Neon PostgreSQL connection string (required for persistent storage / production)
# Example: postgresql://neondb_owner:password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Set to true for temporary in-memory storage (data resets on restart)
# Set to false to use PostgreSQL via DATABASE_URL
DEMO_MEMORY=true

# Behind ONE trusted reverse proxy only; leave 0 for direct connections.
TRUST_PROXY_HOPS=0

# Brevo HTTPS API (not SMTP) for emails
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SafeLink AI

# OpenAI-compatible Chat Completions provider (OpenAI, Mistral, Groq, etc.)
# For Mistral:
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=your_mistral_api_key
# LLM_MODEL=mistral-small-latest
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Google Safe Browsing v4 (optional)
SAFE_BROWSING_API_KEY=

# Optional local Tesseract traineddata directory for offline OCR
OCR_LANG_PATH=
RETENTION_DAYS=30

# Frontend uses same-origin /api by default; never put secrets in VITE_*
VITE_API_URL=
